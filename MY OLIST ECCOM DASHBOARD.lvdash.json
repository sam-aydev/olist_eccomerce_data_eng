{
  "datasets": [
    {
      "name": "2a9ec39a",
      "displayName": "repeat vs new customer",
      "queryLines": [
        "SELECT \r\n",
        "    CASE WHEN order_count > 1 THEN 'Repeat Customer'\r\n",
        "         ELSE 'New Customer' END AS customer_type,\r\n",
        "    COUNT(*) AS count\r\n",
        "FROM (\r\n",
        "    SELECT customer_id, COUNT(*) AS order_count\r\n",
        "    FROM olist_eccom_catalog.gold.fact_orders\r\n",
        "    GROUP BY customer_id\r\n",
        ")\r\n",
        "GROUP BY customer_type;"
      ],
      "catalog": "olist_eccom_catalog",
      "schema": "gold"
    },
    {
      "name": "fdb4b563",
      "displayName": "customer by state",
      "queryLines": [
        "SELECT customer_state, COUNT(*) AS customer_count\r\n",
        "FROM olist_eccom_catalog.gold.dim_customers\r\n",
        "GROUP BY customer_state\r\n",
        "ORDER BY customer_count DESC;"
      ]
    },
    {
      "name": "246060e3",
      "displayName": "total customers",
      "queryLines": [
        "SELECT COUNT(*) AS total_customers\r\n",
        "FROM olist_eccom_catalog.gold.dim_customers;"
      ]
    },
    {
      "name": "cbc596d4",
      "displayName": "active sellers over time",
      "queryLines": [
        "SELECT order_approved_at::date AS date,\r\n",
        "       COUNT(DISTINCT seller_id) AS active_sellers\r\n",
        "FROM olist_eccom_catalog.gold.fact_orders\r\n",
        "GROUP BY date\r\n",
        "ORDER BY date;"
      ]
    }
  ],
